// Ignore repeat taps on the same tree within this window
const REPEAT_TAP_MS = 5 * 60 * 1000;
// Default rain needed (mm, rolling 48h) to count as a watering; override in Summary!H2.
// Newly planted trees need ~50 L/week; ~25 mm over a ~1 m² tree pit is half that,
// so only a genuine soaking resets the clock, not a passing shower.
const DEFAULT_RAIN_MM = 25;
const RAIN_WINDOW_HOURS = 48;

function doGet(e) {
  if (e.parameter.view === 'data') {
    return renderData(e);
  }
  if (e.parameter.view === 'map') {
    return renderMap(e);
  }
  return recordWatering(e);
}

function parseUKDate(v) {
  if (!v) return 0;
  var s = String(v).trim();
  var m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})[ ,]+(\d{1,2}):(\d{2})(?::(\d{2}))?/);
  if (m) {
    return new Date(+m[3], +m[2]-1, +m[1], +m[4], +m[5], +m[6]||0).getTime();
  }
  var t = new Date(s).getTime();
  return isNaN(t) ? 0 : t;
}

function normId(v) {
  return String(v).trim().toLowerCase();
}

function fmt(ms, pattern) {
  return Utilities.formatDate(new Date(ms), 'Europe/London', pattern || 'd MMM, HH:mm');
}

function getSettings(ss) {
  let overdue = 7, rainMm = DEFAULT_RAIN_MM;
  const summary = ss.getSheetByName('Summary');
  if (summary) {
    const h1 = summary.getRange('H1').getValue();
    if (typeof h1 === 'number' && h1 > 0) overdue = h1;
    const h2 = summary.getRange('H2').getValue();
    if (typeof h2 === 'number' && h2 > 0) rainMm = h2;
  }
  return {overdue: overdue, rainMm: rainMm};
}

function getTrees(ss) {
  const rows = ss.getSheetByName('Trees').getDataRange().getValues();
  const trees = [];
  for (let i = 1; i < rows.length; i++) {
    const row = rows[i];
    const id = normId(row[0]);
    if (!id) continue;
    trees.push({
      id: id, rawId: row[0],
      species: String(row[1]), location: String(row[2]),
      lat: parseFloat(row[3]), lng: parseFloat(row[4])
    });
  }
  return trees;
}

// Returns {treeId: [ms, ...]} sorted oldest first
function getTapsById(ss) {
  const log = ss.getSheetByName('Log').getDataRange().getValues();
  const byId = {};
  for (let i = 1; i < log.length; i++) {
    const id = normId(log[i][1]);
    if (!id) continue;
    const t = log[i][0];
    const ms = (t instanceof Date) ? t.getTime() : parseUKDate(t);
    if (!ms) continue;
    (byId[id] = byId[id] || []).push(ms);
  }
  for (const id in byId) byId[id].sort(function(a, b) { return a - b; });
  return byId;
}

// Most recent time the rolling 48h rainfall reached the threshold, using
// Open-Meteo hourly data for the centre of the trees. Cached for an hour.
// Returns {ms, mm}, null if no qualifying rain, or {error: true} if unavailable.
// With cacheOnly, never calls Open-Meteo (returns undefined on a cache miss).
function getLastSoakingRain(trees, settings, cacheOnly) {
  const pts = trees.filter(function(t) { return !isNaN(t.lat) && !isNaN(t.lng); });
  if (!pts.length) return null;
  const lat = pts.reduce(function(s, t) { return s + t.lat; }, 0) / pts.length;
  const lng = pts.reduce(function(s, t) { return s + t.lng; }, 0) / pts.length;
  const pastDays = Math.min(92, settings.overdue + 7); // keep in step with rainDays in mapData

  const cache = CacheService.getScriptCache();
  const cacheKey = ['rain', lat.toFixed(3), lng.toFixed(3), settings.rainMm, pastDays].join(':');
  const cached = cache.get(cacheKey);
  if (cached) return JSON.parse(cached);
  if (cacheOnly) return undefined;

  let result;
  try {
    const url = 'https://api.open-meteo.com/v1/forecast?latitude=' + lat.toFixed(4) +
      '&longitude=' + lng.toFixed(4) + '&hourly=precipitation&timezone=GMT' +
      '&past_days=' + pastDays + '&forecast_days=1';
    const res = UrlFetchApp.fetch(url, {muteHttpExceptions: true});
    if (res.getResponseCode() !== 200) {
      throw new Error('Open-Meteo ' + res.getResponseCode() + ': ' + res.getContentText().slice(0, 200));
    }
    const hourly = JSON.parse(res.getContentText()).hourly;
    const now = Date.now();
    const hours = [];
    for (let i = 0; i < hourly.time.length; i++) {
      // Each value is the total for the hour ending at that time (GMT)
      const ms = new Date(hourly.time[i] + ':00Z').getTime();
      if (ms > now) break; // ignore forecast hours
      hours.push({ms: ms, mm: hourly.precipitation[i] || 0});
    }
    result = null;
    let sum = 0;
    for (let i = 0; i < hours.length; i++) {
      sum += hours[i].mm;
      if (i >= RAIN_WINDOW_HOURS) sum -= hours[i - RAIN_WINDOW_HOURS].mm;
      // Only stamp hours that actually rained, so the watering time is when the
      // soaking happened rather than up to 48h later as the window slides on
      if (sum >= settings.rainMm && hours[i].mm > 0) result = {ms: hours[i].ms, mm: Math.round(sum)};
    }
  } catch (err) {
    console.warn('Rain lookup failed: ' + err);
    return {error: true, message: String(err)};
  }
  cache.put(cacheKey, JSON.stringify(result), 3600);
  return result;
}

function computeStatuses(trees, taps, rain, settings, now) {
  const overdue = settings.overdue;
  const monthAgo = now - 30 * 86400000;
  const yearStart = new Date(fmt(now, 'yyyy') + '-01-01T00:00:00').getTime();
  const rainMs = rain && rain.ms ? rain.ms : 0;
  return trees.filter(function(t) { return !isNaN(t.lat) && !isNaN(t.lng); }).map(function(t) {
    const list = taps[t.id] || [];
    const lastTap = list.length ? list[list.length - 1] : 0;
    const last = Math.max(lastTap, rainMs);
    let days = null, status = 'never';
    if (last) {
      days = Math.floor((now - last) / 86400000);
      status = days >= overdue ? 'overdue' : days >= overdue - 2 ? 'soon' : 'ok';
    }
    return {
      id: t.id, species: t.species, location: t.location,
      lat: t.lat, lng: t.lng, days: days, status: status,
      lastTap: lastTap ? fmt(lastTap) : null,
      rainReset: rainMs > lastTap,
      due: last ? fmt(last + overdue * 86400000, 'EEE d MMM') : null,
      count30: list.filter(function(ms) { return ms >= monthAgo; }).length,
      countYear: list.filter(function(ms) { return ms >= yearStart; }).length
    };
  });
}

function mapContext(ss, cacheOnlyRain) {
  const settings = getSettings(ss);
  const trees = getTrees(ss);
  const taps = getTapsById(ss);
  const rain = getLastSoakingRain(trees, settings, cacheOnlyRain);
  return {settings: settings, trees: trees, taps: taps, rain: rain};
}

// Public map page: the GitHub Pages copy if Script Property "mapUrl" is set,
// otherwise the map served by this script
function mapPageUrl(treeId) {
  const pages = PropertiesService.getScriptProperties().getProperty('mapUrl');
  const base = pages || ScriptApp.getService().getUrl() + '?view=map';
  return treeId ? base + (base.indexOf('?') < 0 ? '?' : '&') + 'tree=' + encodeURIComponent(treeId) : base;
}

function recordWatering(e) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const trees = getTrees(ss);
  const taps = getTapsById(ss);
  const id = normId(e.parameter.id || '');
  const tree = trees.filter(function(t) { return t.id === id; })[0];

  if (!tree) {
    return HtmlService.createHtmlOutput(buildConfirmHtml({
      ok: false, mapUrl: mapPageUrl(),
      heading: 'Tag not recognised',
      lines: ['This tag isn\u2019t linked to a tree on the list, so nothing was recorded.']
    })).addMetaTag('viewport', 'width=device-width, initial-scale=1');
  }

  // Log before anything else so a slow or dropped connection can't lose the watering
  const now = Date.now();
  const list = taps[id] || [];
  const prev = list.length ? list[list.length - 1] : 0;
  const repeat = prev && now - prev < REPEAT_TAP_MS;
  if (!repeat) {
    ss.getSheetByName('Log').appendRow([new Date(now), tree.rawId]);
    list.push(now);
    taps[id] = list;
  }

  const lines = [];
  if (repeat) {
    lines.push('Already recorded at ' + fmt(prev, 'HH:mm') + ' \u2014 no need to tap again.');
  } else if (prev) {
    const d = Math.floor((now - prev) / 86400000);
    lines.push('Previously watered ' + fmt(prev) + ' (' +
      (d === 0 ? 'earlier today' : d === 1 ? '1 day ago' : d + ' days ago') + ').');
  } else {
    lines.push('This is the first recorded watering for this tree.');
  }
  const month = fmt(now, 'yyyy-MM');
  const n = list.filter(function(ms) { return fmt(ms, 'yyyy-MM') === month; }).length;
  lines.push('That\u2019s ' + n + ' watering' + (n === 1 ? '' : 's') + ' for this tree in ' +
    fmt(now, 'MMMM') + '.');

  // Neighbour colours for the optional mini map; rain only if already cached,
  // so a tap never waits on Open-Meteo
  const settings = getSettings(ss);
  const rain = getLastSoakingRain(trees, settings, true);
  return HtmlService.createHtmlOutput(buildConfirmHtml({
    ok: true, mapUrl: mapPageUrl(id),
    heading: repeat ? 'Already recorded \u2014 thanks!' : 'Watered \u2014 thanks!',
    tree: tree, lines: lines,
    points: computeStatuses(trees, taps, rain, settings, now),
    tileUrl: tileUrl()
  })).addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

function mapData(e) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ctx = mapContext(ss);
  const now = Date.now();
  return {
    points: computeStatuses(ctx.trees, ctx.taps, ctx.rain, ctx.settings, now),
    info: {
      overdue: ctx.settings.overdue, rainMm: ctx.settings.rainMm,
      rain: ctx.rain && ctx.rain.ms ? {when: fmt(ctx.rain.ms), mm: ctx.rain.mm} : null,
      rainError: !!(ctx.rain && ctx.rain.error),
      rainDays: Math.min(92, ctx.settings.overdue + 7),
      updated: fmt(now), focus: normId(e.parameter.tree || '')
    },
    tileUrl: tileUrl(),
    rawRain: ctx.rain
  };
}

// JSON for the GitHub Pages map (index.html in the repo)
function renderData(e) {
  const d = mapData(e);
  delete d.rawRain;
  return ContentService.createTextOutput(JSON.stringify(d))
    .setMimeType(ContentService.MimeType.JSON);
}

function renderMap(e) {
  if (PropertiesService.getScriptProperties().getProperty('mapUrl') && !e.parameter.debug) {
    const url = mapPageUrl(e.parameter.tree ? normId(e.parameter.tree) : '');
    return HtmlService.createHtmlOutput(
      '<script>window.top.location.href = ' + JSON.stringify(url) + ';<\/script>' +
      '<p style="font-family:sans-serif"><a href="' + url + '" target="_top">Open the tree map</a></p>');
  }
  const d = mapData(e);
  if (e.parameter.debug) {
    return HtmlService.createHtmlOutput('<pre>' +
      JSON.stringify({info: d.info, rawRain: d.rawRain, cartoKeySet: d.tileUrl.indexOf('?key=') > 0,
        points: d.points}, null, 2) +
      '</pre>');
  }
  return HtmlService.createHtmlOutput(buildMapHtml(d.points, d.info, d.tileUrl))
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

function tileUrl() {
  const key = (PropertiesService.getScriptProperties().getProperty('key') || '').trim();
  if (!key) console.warn('No Carto API key in Script Properties ("key") - tiles will be watermarked');
  return 'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png' +
    (key ? '?key=' + encodeURIComponent(key) : '');
}

const LEAFLET_HEAD = `<meta charset="utf-8">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"><\/script>`;

const ATTRIBUTION = '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a> ' +
  '&copy; <a href="https://carto.com/attributions" target="_blank">CARTO</a>';

const COLOURS = {overdue:'#c0392b', never:'#5d6d7e', soon:'#e67e22', ok:'#27ae60'};

// Kept deliberately light for patchy mobile data: no scripts or tiles load
// unless the volunteer taps "Show nearby trees"
function buildConfirmHtml(o) {
  const extra = o.ok ? `
<button id="show" type="button">Show nearby trees</button>
<div id="mini" hidden></div>
<p><a href="${o.mapUrl}" target="_top">Open the full map \u203a</a></p>
<script>
document.getElementById('show').onclick = function() {
  var btn = this;
  btn.disabled = true; btn.textContent = 'Loading map\u2026';
  var css = document.createElement('link');
  css.rel = 'stylesheet'; css.href = 'https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css';
  document.head.appendChild(css);
  var js = document.createElement('script');
  js.src = 'https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js';
  js.onerror = function() { btn.disabled = false; btn.textContent = 'Couldn\u2019t load \u2014 try again'; };
  js.onload = function() {
    btn.remove();
    var el = document.getElementById('mini'); el.hidden = false;
    var pts = ${JSON.stringify(o.points)};
    var colours = ${JSON.stringify(COLOURS)};
    var here = ${JSON.stringify(o.tree.id)};
    var map = L.map(el, {zoomControl:false, dragging:false, touchZoom:false, scrollWheelZoom:false,
      doubleClickZoom:false, boxZoom:false, keyboard:false});
    L.tileLayer(${JSON.stringify(o.tileUrl)},
      {attribution:${JSON.stringify(ATTRIBUTION)}, subdomains:'abcd', maxNativeZoom:18, maxZoom:20}).addTo(map);
    map.attributionControl.setPrefix(false);
    pts.forEach(function(p){
      var me = p.id === here;
      L.circleMarker([p.lat, p.lng], {radius: me ? 13 : 8, color:'#fff', weight: me ? 3 : 2,
        fillColor: colours[me ? 'ok' : p.status], fillOpacity:1, interactive:false}).addTo(map);
      if (me) map.setView([p.lat, p.lng], 18);
    });
  };
  document.head.appendChild(js);
};
<\/script>` : `<p><a href="${o.mapUrl}" target="_top">View the tree map \u203a</a></p>`;

  return `<!DOCTYPE html><html><head><meta charset="utf-8">
<style>
  body{font-family:system-ui,-apple-system,sans-serif;margin:0;padding:8vh 16px 32px;
    text-align:center;color:#1f2d24;background:#f4f8f3}
  .wrap{max-width:420px;margin:0 auto}
  .tick{font-size:44px;line-height:1}
  h1{font-size:24px;margin:12px 0 4px}
  .tree{font-size:17px;font-weight:600;margin:0}
  .where{color:#56645b;margin:2px 0 16px}
  p{margin:6px 0;line-height:1.4}
  button{font:inherit;font-weight:600;color:#1f6f3a;background:#fff;border:1px solid #c9d8cb;
    border-radius:10px;padding:10px 16px;margin:20px 0 8px;cursor:pointer}
  #mini{height:200px;border-radius:12px;overflow:hidden;border:1px solid #d5e0d6;margin:20px 0 8px}
  a{color:#1f6f3a;font-weight:600}
</style></head><body><div class="wrap">
  <div class="tick">${o.ok ? '\u{1F4A7}' : '\u2753'}</div>
  <h1>${o.heading}</h1>
  ${o.tree ? `<p class="tree">${o.tree.species}</p><p class="where">${o.tree.location}</p>` : ''}
  ${o.lines.map(function(l) { return '<p>' + l + '</p>'; }).join('')}
  ${extra}
</div></body></html>`;
}

function buildMapHtml(points, info, tileUrl) {
  return `<!DOCTYPE html><html><head>${LEAFLET_HEAD}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet.markercluster@1.5.3/dist/MarkerCluster.css"/>
<script src="https://cdn.jsdelivr.net/npm/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"><\/script>
<style>
  html,body,#map{height:100%;margin:0}
  body{font-family:system-ui,-apple-system,sans-serif}
  .panel{background:#fff;border-radius:10px;box-shadow:0 1px 5px rgba(0,0,0,.25);
    font-size:13px;color:#1f2d24;line-height:1.35}
  .legend{padding:8px 10px;max-width:220px}
  .legend .row{display:flex;align-items:center;gap:7px;margin:2px 0}
  .dot{width:12px;height:12px;border-radius:50%;border:2px solid #fff;
    box-shadow:0 0 0 1px rgba(0,0,0,.15);flex:none}
  .legend .note{color:#56645b;font-size:11.5px;margin-top:6px}
  .due{max-width:240px}
  .due button{all:unset;cursor:pointer;display:block;padding:7px 11px;font-weight:600}
  .due ul{list-style:none;margin:0;padding:0 0 4px;max-height:40vh;overflow:auto;
    border-top:1px solid #e3e9e4}
  .due li{display:flex;gap:7px;align-items:center;padding:6px 11px;cursor:pointer}
  .due li:hover{background:#f1f5f1}
  .due li small{color:#56645b;margin-left:auto;white-space:nowrap}
  .locate{all:unset;cursor:pointer;width:30px;height:30px;display:flex;align-items:center;
    justify-content:center;background:#fff;font-size:17px}
  .toast{position:absolute;left:50%;top:12px;transform:translateX(-50%);z-index:1000;
    background:#1f2d24;color:#fff;padding:8px 12px;border-radius:8px;font-size:13px;
    max-width:80vw;text-align:center}
  .pop b{font-size:14px}
  .pop .muted{color:#56645b}
</style></head><body>
<div id="map"></div>
<script>
window.addEventListener('load', function() {
  var pts = ${JSON.stringify(points)};
  var info = ${JSON.stringify(info)};
  var colours = ${JSON.stringify(COLOURS)};
  var labels = {ok:'Watered recently', soon:'Due within 2 days',
    overdue:'Overdue (' + info.overdue + '+ days)', never:'No watering recorded'};
  var map = L.map('map', {maxZoom:20}); // tiles stop at 18 and are enlarged beyond that
  L.tileLayer(${JSON.stringify(tileUrl)},
    {attribution:${JSON.stringify(ATTRIBUTION)}, subdomains:'abcd', maxNativeZoom:18, maxZoom:20}).addTo(map);

  function toast(msg) {
    var t = document.createElement('div');
    t.className = 'toast'; t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(function(){ t.remove(); }, 4000);
  }

  function popupHtml(p) {
    var h = '<div class="pop"><b>' + p.species + '</b><br><span class="muted">' + p.location + '</span><br><br>';
    if (p.lastTap) h += 'Last watered: ' + p.lastTap + '<br>';
    else h += 'No watering recorded yet<br>';
    if (p.rainReset && info.rain) h += 'Heavy rain (' + info.rain.mm + ' mm, ' + info.rain.when + ') counted as a watering<br>';
    if (p.due) h += (p.status === 'overdue' ? '<b style="color:' + colours.overdue + '">Overdue</b> since ' : 'Next due: ') + p.due + '<br>';
    h += '<span class="muted">Waterings: ' + p.count30 + ' in last 30 days · ' + p.countYear + ' this year</span></div>';
    return h;
  }

  var rank = {ok:0, soon:1, never:2, overdue:3};
  var cluster = L.markerClusterGroup({
    maxClusterRadius: 45,
    iconCreateFunction: function(c) {
      var worst = 'ok';
      c.getAllChildMarkers().forEach(function(m){
        if (rank[m.options._status] > rank[worst]) worst = m.options._status;
      });
      return L.divIcon({
        html: '<div style="background:'+colours[worst]+';width:34px;height:34px;'+
              'border-radius:50%;border:2.5px solid #fff;color:#fff;font:600 13px sans-serif;'+
              'display:flex;align-items:center;justify-content:center;">'+c.getChildCount()+'</div>',
        className: '', iconSize: [34,34]
      });
    }
  });

  var bounds = [], markers = {};
  pts.forEach(function(p){
    var m = L.circleMarker([p.lat, p.lng], {radius:11, color:'#fff', weight:2.5,
      fillColor: colours[p.status], fillOpacity:1, _status: p.status});
    m.bindPopup(popupHtml(p));
    cluster.addLayer(m);
    markers[p.id] = m;
    bounds.push([p.lat, p.lng]);
  });
  map.addLayer(cluster);
  if (bounds.length) map.fitBounds(bounds, {padding:[40,40], maxZoom:17});
  else map.setView([53.48, -1.49], 15);

  function showTree(id) {
    var m = markers[id];
    if (m) cluster.zoomToShowLayer(m, function(){ m.openPopup(); });
  }
  if (info.focus) showTree(info.focus);

  // Legend
  var legend = L.control({position:'bottomleft'});
  legend.onAdd = function() {
    var d = L.DomUtil.create('div', 'panel legend');
    var h = '';
    ['ok','soon','overdue','never'].forEach(function(s){
      h += '<div class="row"><span class="dot" style="background:'+colours[s]+'"></span>'+labels[s]+'</div>';
    });
    h += '<div class="note">' + (info.rainError ? 'Rain data unavailable right now.' :
      'Heavy rain (' + info.rainMm + ' mm+ in 48 h) counts as a watering.' +
      (info.rain ? ' Last: ' + info.rain.when + '.' :
        ' None in the last ' + (info.rainDays || Math.min(92, info.overdue + 7)) + ' days.')) +
      '<br>Updated ' + info.updated + '</div>';
    d.innerHTML = h;
    L.DomEvent.disableClickPropagation(d);
    return d;
  };
  legend.addTo(map);

  // Trees needing water, collapsed by default so the map stays the focus
  var needy = pts.filter(function(p){ return p.status !== 'ok'; }).sort(function(a, b){
    return rank[b.status] - rank[a.status] || (b.days || 0) - (a.days || 0);
  });
  var due = L.control({position:'topright'});
  due.onAdd = function() {
    var d = L.DomUtil.create('div', 'panel due');
    L.DomEvent.disableClickPropagation(d);
    L.DomEvent.disableScrollPropagation(d);
    var btn = L.DomUtil.create('button', '', d);
    if (!needy.length) { btn.textContent = '✓ All trees watered'; return d; }
    btn.textContent = needy.length + (needy.length === 1 ? ' tree needs' : ' trees need') + ' water ▾';
    var ul = L.DomUtil.create('ul', '', d);
    ul.style.display = 'none';
    needy.forEach(function(p){
      var li = L.DomUtil.create('li', '', ul);
      li.innerHTML = '<span class="dot" style="background:'+colours[p.status]+'"></span>' +
        p.species + ', ' + p.location.split(',')[0] +
        '<small>' + (p.days === null ? 'never' : p.days + ' d') + '</small>';
      li.onclick = function(){ ul.style.display = 'none'; showTree(p.id); };
    });
    btn.onclick = function(){ ul.style.display = ul.style.display === 'none' ? '' : 'none'; };
    return d;
  };
  due.addTo(map);

  // Show my location
  var locate = L.control({position:'topleft'});
  var me = null;
  locate.onAdd = function() {
    var d = L.DomUtil.create('div', 'leaflet-bar');
    var b = L.DomUtil.create('button', 'locate', d);
    b.title = 'Show my location'; b.setAttribute('aria-label', 'Show my location');
    b.textContent = '◎';
    L.DomEvent.disableClickPropagation(d);
    b.onclick = function(){
      if (!navigator.geolocation) return toast('Location isn’t available on this device.');
      map.locate({setView:true, maxZoom:17});
    };
    return d;
  };
  locate.addTo(map);
  map.on('locationfound', function(e){
    if (me) map.removeLayer(me);
    me = L.layerGroup([
      L.circle(e.latlng, {radius:e.accuracy, color:'#2e86de', weight:1, fillOpacity:.1, interactive:false}),
      L.circleMarker(e.latlng, {radius:7, color:'#fff', weight:2.5, fillColor:'#2e86de', fillOpacity:1, interactive:false})
    ]).addTo(map);
  });
  map.on('locationerror', function(e){
    toast(e.code === 1 ? 'Location permission was blocked, so we can’t show where you are.'
                       : 'Couldn’t find your location just now.');
  });
});
<\/script></body></html>`;
}
